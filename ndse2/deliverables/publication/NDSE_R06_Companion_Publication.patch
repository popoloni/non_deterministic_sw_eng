@@ -0,0 +1,70 @@
+"""Transparent scenario arithmetic, never calibrated production estimates."""
+
+from __future__ import annotations
+from decimal import Decimal
+
+
+def nonnegative(value: object, name: str) -> Decimal:
+    if isinstance(value, bool):
+        raise ValueError(name)
+    try:
+        d = Decimal(str(value))
+    except Exception as exc:
+        raise ValueError(name) from exc
+    if not d.is_finite() or d < 0:
+        raise ValueError(name)
+    return d
+
+
+def break_even_minutes(extra_cost: object, hourly_rate: object) -> Decimal:
+    extra = nonnegative(extra_cost, "extra_cost")
+    rate = nonnegative(hourly_rate, "hourly_rate")
+    if rate == 0:
+        raise ValueError("positive hourly rate required")
+    return Decimal(60) * extra / rate
+
+
+def net_optional_cost(
+    extra_cost: object, saved_minutes: object, hourly_rate: object
+) -> Decimal:
+    return nonnegative(extra_cost, "extra_cost") - nonnegative(
+        saved_minutes, "saved_minutes"
+    ) * nonnegative(hourly_rate, "hourly_rate") / Decimal(60)
+
+
+def local_period_cost(
+    *,
+    active_watts: object,
+    active_hours: object,
+    idle_watts: object,
+    idle_hours: object,
+    price_per_kwh: object,
+    allocated_hardware_cost: object,
+    support_cost: object,
+    accepted_changes: int,
+) -> dict[str, Decimal | None]:
+    """All inputs observed or explicitly assumed over ONE common period.
+    Hardware/support allocation policy is supplied, not inferred.
+    Active/idle hours must be disjoint. Cost per accepted change is undefined at zero.
+    """
+    if type(accepted_changes) is not int or accepted_changes < 0:
+        raise ValueError("accepted_changes")
+    energy = (
+        nonnegative(active_watts, "active_watts")
+        * nonnegative(active_hours, "active_hours")
+        + nonnegative(idle_watts, "idle_watts") * nonnegative(idle_hours, "idle_hours")
+    ) / Decimal(1000)
+    energy_cost = energy * nonnegative(price_per_kwh, "price_per_kwh")
+    total = (
+        energy_cost
+        + nonnegative(allocated_hardware_cost, "allocated_hardware_cost")
+        + nonnegative(support_cost, "support_cost")
+    )
+    return {
+        "kwh": energy,
+        "energy_cost": energy_cost,
+        "total_allocated_cost": total,
+        "cost_per_accepted_change": (
+            total / Decimal(accepted_changes) if accepted_changes else None
+        ),
+    }
diff --git a/ndse2/lab/companion/v10/evidence_manifest.py b/ndse2/lab/companion/v10/evidence_manifest.py
new file mode 100644
index 0000000..7a7db23
--- /dev/null
+++ b/ndse2/lab/companion/v10/evidence_manifest.py
@@ -0,0 +1,66 @@
+"""Version/digest consistency of synthetic evidence. Not signatures or proof of execution."""
+
+from __future__ import annotations
+import hashlib
+from pathlib import Path
+from typing import Any
+
+ROLES = {"candidate", "intent", "oracle", "environment"}
+
+
+def sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def make_manifest(
+    paths: dict[str, Path],
+    intent_id: str,
+    command: list[str],
+    exit_code: int,
+    unchecked: list[str],
+    created_at: int,
+) -> dict[str, Any]:
+    if set(paths) != ROLES or not intent_id or not command:
+        raise ValueError("all four artifact roles, intent and command required")
+    if type(exit_code) is not int or type(created_at) is not int or created_at < 0:
+        raise ValueError("invalid execution metadata")
+    return {
+        "intent_id": intent_id,
+        "artifacts": {
+            role: {"path": str(p), "sha256": sha(p)} for role, p in paths.items()
+        },
+        "command": command,
+        "exit_code": exit_code,
+        "unchecked": unchecked,
+        "created_at": created_at,
+        "producer": "synthetic trusted harness",
+        "producer_authenticated": False,
+        "execution_attested": False,
+    }
+
+
+def verify_manifest(
+    bundle: dict[str, Any], current: dict[str, Path], intent_id: str
+) -> dict[str, str]:
+    if set(current) != ROLES:
+        return {"status": "HOLD", "reason": "INCOMPLETE_CURRENT_CONTEXT"}
+    if bundle.get("intent_id") != intent_id:
+        return {"status": "HOLD", "reason": "STALE_INTENT"}
+    artifacts = bundle.get("artifacts", {})
+    if set(artifacts) != ROLES:
+        return {"status": "HOLD", "reason": "INCOMPLETE_MANIFEST"}
+    for role, path in current.items():
+        try:
+            matches = artifacts[role].get("sha256") == sha(path)
+        except (OSError, AttributeError):
+            matches = False
+        if not matches:
+            return {"status": "HOLD", "reason": "STALE_OR_MISSING_" + role.upper()}
+    if type(bundle.get("exit_code")) is not int or bundle["exit_code"] != 0:
+        return {"status": "HOLD", "reason": "FAILED_OR_MISSING_RESULT"}
+    if not bundle.get("command") or "unchecked" not in bundle:
+        return {"status": "HOLD", "reason": "INCOMPLETE_EXECUTION_METADATA"}
+    return {
+        "status": "READY_FOR_HUMAN_REVIEW_AUTHORITY_UNVERIFIED",
+        "reason": "RECORDED_DIGESTS_MATCH",
+    }
