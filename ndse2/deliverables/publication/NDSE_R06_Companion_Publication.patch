diff --git a/ndse2/lab/companion/v10/control_state.py b/ndse2/lab/companion/v10/control_state.py
new file mode 100644
index 0000000..7ac095b
--- /dev/null
+++ b/ndse2/lab/companion/v10/control_state.py
@@ -0,0 +1,113 @@
+"""Offline control-plane demonstration. No provider, credentials or release API.
+
+Inputs named current_* and now must come from a trusted controller in a real system.
+JSON persistence here is not authenticated or an OS sandbox.
+"""
+
+from dataclasses import asdict, dataclass, replace
+from pathlib import Path
+import json
+
+
+def nonnegative_int(value: int, name: str) -> None:
+    if type(value) is not int or value < 0:
+        raise ValueError(f"{name} must be a nonnegative integer")
+
+
+@dataclass(frozen=True)
+class LoopState:
+    intent: str = "INT-002"
+    contract_digest: str = "synthetic-contract-v2"
+    used_minor: int = 0
+    cap_minor: int = 200
+    calls_used: int = 0
+    max_calls: int = 4
+    attempts_used: int = 0
+    max_attempts: int = 2
+    deadline: int = 900
+    revoked: bool = False
+    last_signature: str = ""
+    repeated_signature: int = 0
+
+    def validate(self) -> None:
+        for name in (
+            "used_minor",
+            "cap_minor",
+            "calls_used",
+            "max_calls",
+            "attempts_used",
+            "max_attempts",
+            "deadline",
+            "repeated_signature",
+        ):
+            nonnegative_int(getattr(self, name), name)
+        if (
+            not self.intent
+            or not self.contract_digest
+            or type(self.revoked) is not bool
+        ):
+            raise ValueError("invalid identity or revocation flag")
+
+    def save(self, path: Path) -> None:
+        self.validate()
+        path.write_text(json.dumps(asdict(self), sort_keys=True))
+
+    @classmethod
+    def load(cls, path: Path) -> "LoopState":
+        obj = cls(**json.loads(path.read_text()))
+        obj.validate()
+        return obj
+
+
+def admit(
+    state: LoopState,
+    *,
+    current_intent: str,
+    current_contract_digest: str,
+    now: int,
+    next_upper_bound_minor: int | None,
+    new_candidate: bool = False,
+) -> tuple[str, LoopState]:
+    state.validate()
+    nonnegative_int(now, "now")
+    if type(new_candidate) is not bool:
+        raise ValueError("new_candidate must be bool")
+    if state.revoked:
+        return "STOP_REVOKED", state
+    if (state.intent, state.contract_digest) != (
+        current_intent,
+        current_contract_digest,
+    ):
+        return "STOP_STALE_INTENT", state
+    if now >= state.deadline:
+        return "STOP_DEADLINE", state
+    if state.repeated_signature >= 2:
+        return "ESCALATE_REPEATED_DIAGNOSTIC", state
+    if next_upper_bound_minor is None:
+        return "STOP_UNBOUNDED_COST", state
+    nonnegative_int(next_upper_bound_minor, "next_upper_bound_minor")
+    if (
+        state.calls_used >= state.max_calls
+        or state.used_minor + next_upper_bound_minor > state.cap_minor
+    ):
+        return "STOP_BUDGET", state
+    if new_candidate and state.attempts_used >= state.max_attempts:
+        return "STOP_ATTEMPTS", state
+    return "ACTION_ADMITTED_NOT_ACCEPTED", replace(
+        state,
+        used_minor=state.used_minor + next_upper_bound_minor,
+        calls_used=state.calls_used + 1,
+        attempts_used=state.attempts_used + int(new_candidate),
+    )
+
+
+def record_diagnostic(state: LoopState, signature: str) -> LoopState:
+    if not signature:
+        raise ValueError("a diagnostic signature must name the failure")
+    return replace(
+        state,
+        last_signature=signature,
+        repeated_signature=(
+            state.repeated_signature + 1 if state.last_signature == signature else 1
+        ),
+    )
diff --git a/ndse2/lab/companion/v10/coordination.py b/ndse2/lab/companion/v10/coordination.py
new file mode 100644
index 0000000..92c1cf2
--- /dev/null
+++ b/ndse2/lab/companion/v10/coordination.py
@@ -0,0 +1,95 @@
+"""Sequential synthetic target leases and queue admission, not distributed locks."""
+
+from __future__ import annotations
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Lease:
+    owner: str
+    intent: str
+    expiry: int
+    generation: int
+
+
+class Coordinator:
+    def __init__(self, intent: str = "INT-002", capacity: int = 8):
+        if type(capacity) is not int or capacity < 1:
+            raise ValueError("positive capacity")
+        self.intent = intent
+        self.capacity = capacity
+        self.leases = {}
+        self.pending = {}
+        self.events = {}
+        self.generation = 0
+
+    def grant(
+        self, owner: str, target: str, *, now: int, expiry: int
+    ) -> tuple[str, int | None]:
+        if (
+            not owner
+            or not target
+            or type(now) is not int
+            or type(expiry) is not int
+            or expiry <= now
+        ):
+            raise ValueError("invalid lease")
+        old = self.leases.get(target)
+        if old and old.expiry > now:
+            return "HOLD_TARGET_ALREADY_LEASED", None
+        self.generation += 1
+        self.leases[target] = Lease(owner, self.intent, expiry, self.generation)
+        return "LEASE_GRANTED_NOT_MERGE_AUTHORITY", self.generation
+
+    def submit(
+        self,
+        event_id: str,
+        owner: str,
+        target: str,
+        intent: str,
+        generation: int,
+        *,
+        now: int,
+    ) -> str:
+        if not event_id or type(now) is not int or type(generation) is not int:
+            raise ValueError("invalid event")
+        payload = (owner, target, intent, generation)
+        if event_id in self.events:
+            return (
+                "DUPLICATE_NO_NEW_SUBMISSION"
+                if self.events[event_id] == payload
+                else "HOLD_EVENT_ID_CONFLICT"
+            )
+        if intent != self.intent:
+            return "HOLD_STALE_INTENT"
+        lease = self.leases.get(target)
+        if (
+            not lease
+            or lease.owner != owner
+            or lease.generation != generation
+            or lease.intent != intent
+        ):
+            return "HOLD_WRONG_LEASE"
+        if now >= lease.expiry:
+            return "HOLD_EXPIRED_LEASE"
+        if len(self.pending) >= self.capacity:
+            return "HOLD_REVIEW_CAPACITY"
+        self.events[event_id] = payload
+        self.pending[event_id] = payload
+        return "ADMITTED_TO_REVIEW_QUEUE_NOT_ACCEPTED"
+
+    def change_intent(self, new_intent: str) -> None:
+        if not new_intent:
+            raise ValueError("intent required")
+        self.intent = new_intent
+        # Retain old leases/events for history; submissions must match the current revision.
+
+    def withdraw(self, event_id: str, reason: str) -> None:
+        if not reason:
+            raise ValueError("reason required")
+        self.pending.pop(event_id, None)
+
+    def revoke(self, target: str, reason: str) -> None:
+        if not reason:
+            raise ValueError("reason required")
+        self.leases.pop(target, None)
