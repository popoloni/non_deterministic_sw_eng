index 0000000..579cdf7
--- /dev/null
+++ b/ndse2/scripts/offline_test_guard/sitecustomize.py
@@ -0,0 +1,10 @@
+"""Test-only network guard, inherited by child Python interpreters; not an OS sandbox."""
+import socket
+def blocked(*args, **kwargs):
+    raise RuntimeError("NETWORK_DISABLED_FOR_V10_TESTS")
+socket.create_connection = blocked
+class OfflineSocket(socket.socket):
+    connect = blocked
+    connect_ex = blocked
+    sendto = blocked
+socket.socket = OfflineSocket
